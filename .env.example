# OpenAI-compatible chat completions API (any provider). A key is optional for keyless local providers.
# Free options:
#   Ollama (local, no key):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2
#   Gemini free tier:        LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   Groq free tier:          LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

# Optional: your own Sepolia RPC. Falls back to viem's default public endpoint.
SEPOLIA_RPC_URL=

PORT=3000

# Only for `npm run set-record` (Sepolia testnet key that owns your ENS name).
# PRIVATE_KEY=
