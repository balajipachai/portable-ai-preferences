# OpenAI-compatible chat completions API (any provider).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_MS=20000

# Optional: your own Sepolia RPC. Falls back to viem's default public endpoint.
SEPOLIA_RPC_URL=

PORT=3000

# Only for `npm run set-record` (Sepolia testnet key that owns your ENS name).
# PRIVATE_KEY=
