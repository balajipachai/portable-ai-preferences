{
  "name": "portable-ai-preferences",
  "version": "1.0.0",
  "description": "An assistant that reads your AI preferences from an ENS text record and honours them.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "cases": "tsx scripts/run-cases.ts",
    "record-cases": "tsx scripts/record-cases.ts",
    "set-record": "tsx scripts/set-record.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
